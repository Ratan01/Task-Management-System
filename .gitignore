# ================================

# Spring Boot

# ================================

# Keep application.yml/application.properties in Git when they

# contain only non-sensitive configuration and environment-variable

# placeholders.

# Ignore local/profile-specific configuration

**/src/main/resources/application-local.yml
**/src/main/resources/application-local.yaml
**/src/main/resources/application-local.properties

**/src/main/resources/application-prod.yml
**/src/main/resources/application-prod.yaml
**/src/main/resources/application-prod.properties

**/src/main/resources/application-dev-local.yml
**/src/main/resources/application-dev-local.yaml
**/src/main/resources/application-dev-local.properties

